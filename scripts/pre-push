#!/bin/sh
echo "Running pre-push checks..."

echo "Lint..."
uv run ruff check src/ tests/
if [ $? -ne 0 ]; then
    echo "Lint failed. Push aborted."
    exit 1
fi

echo "Unit tests..."
uv run pytest tests/ -q
if [ $? -ne 0 ]; then
    echo "Tests failed. Push aborted."
    exit 1
fi

echo "All checks passed."
